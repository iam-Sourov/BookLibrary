# Server Port
PORT=5001

# Database Connection String (PostgreSQL / Supabase)
DATABASE_URL=postgresql://username:password@hostname:6543/postgres

# Supabase Auth Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend Origins for CORS
SITE_DOMAIN=http://localhost:5173
FRONTEND_ORIGIN=https://your-app-name.vercel.app

# Stripe Secret Key (Optional / Payment Integration)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
